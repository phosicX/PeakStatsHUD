<Project Sdk="Microsoft.NET.Sdk">
  <!-- Project properties -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>com.github.phosicX.PeakStatsHUD</AssemblyName>
    <AssemblyTitle>PeakStatsHUD</AssemblyTitle>
    <Version>1.0.1</Version>
  </PropertyGroup>

  <!-- ThunderPipe properties -->
  <PropertyGroup>
    <IsThunderstorePackable>true</IsThunderstorePackable>
    <ThunderstoreName>PeakStatsHUD</ThunderstoreName>
    <ThunderstoreDescription>Edge-style stamina and affliction numbers for PEAK, with a separate hunger countdown, teammate name spacing and per-value toggles. Based on PeakStatsEx and StaminaStatsTactikot.</ThunderstoreDescription>
    <!--
      Communities and package categories metadata for publishing with ThunderPipe.
      Communities: https://thunderstore.io/api/experimental/community/
      Categories: https://thunderstore.io/api/experimental/community/peak/category/
    -->
    <ThunderstoreCommunities>peak</ThunderstoreCommunities>
    <ThunderstoreCategories>mods, qol, client</ThunderstoreCategories>
  </PropertyGroup>

  <!--
    Define mod files to copy to the relative BepInEx directory after build
    and where they are packed to when building a Thunderstore package
  -->
  <ItemGroup>
    <ModFile Include="$(TargetPath)" Destination="plugins/" />
  </ItemGroup>

  <!-- Thunderstore package metadata -->
  <ItemGroup>
    <ThunderstorePackageFile Include="$(SolutionRoot)README.md" />
    <ThunderstorePackageFile Include="$(SolutionRoot)CHANGELOG.md" />
    <ThunderstorePackageFile Include="$(SolutionRoot)icon.png" />
    <ThunderstorePackageFile Include="$(SolutionRoot)LICENSE" />

    <ThunderstoreDependency Include="BepInEx-BepInExPack_PEAK" Version="5.4.75301" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="TerrainRandomiser">
      <HintPath>$(PEAKBepInExDir)/plugins/Snosz-TerrainRandomiser/TerrainRandomiser.dll</HintPath>
      <Private></Private>
    </Reference>
    <Reference Include="TerrainCustomiser">
      <HintPath>$(PEAKBepInExDir)/plugins/Snosz-TerrainCustomiser/TerrainCustomiser.dll</HintPath>
      <Private></Private>
    </Reference>
    <Reference Include="PLL">
      <HintPath>$(PEAKBepInExDir)/plugins/AeralisFoundation-PLL_Library/PLL_Library.dll</HintPath>
      <Private></Private>
    </Reference>
  </ItemGroup>
</Project>
